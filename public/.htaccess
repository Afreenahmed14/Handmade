# SPA fallback for Apache hosting (e.g. Hostinger): serve index.html for any path that is not a real file or folder.
# Vite copies this file from public/ into dist/ on build.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
